# ASLM Rides — environment variables
#
# All four are required for the app to function. Without them, pages that
# need live data show a clear "not configured" state rather than crashing
# or faking data.

# --- Supabase (database, auth, realtime) -------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, used by API routes for ride matching.
# NEVER expose this with a NEXT_PUBLIC_ prefix or ship it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mapbox (maps, geocoding, routing) ----------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=
